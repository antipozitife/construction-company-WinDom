{
  "name": "windom-react-app",
  "version": "1.0.0",
  "description": "Адаптивный сайт строительной компании WinDom — портфолио-проект на React и TypeScript",
  "main": "index.js",
  "homepage": "./",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "webpack serve --open",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write \"{src,tests}/**/*.{js,ts,tsx,css}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{js,ts,tsx,css}\" \"*.{js,json,md}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.1",
    "react-scroll": "^1.9.3",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/react-scroll": "^1.8.10",
    "babel-loader": "^10.0.0",
    "baseline-browser-mapping": "^2.11.3",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.4",
    "prettier": "^3.6.2",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
